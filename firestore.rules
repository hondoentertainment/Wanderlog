rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFriendOf(ownerId) {
      return exists(
        /databases/$(database)/documents/users/$(ownerId)/friends/$(request.auth.uid)
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isFriendOf(userId);
      allow write: if isOwner(userId);

      match /friends/{friendId} {
        allow read: if isOwner(userId) || isOwner(friendId);
        allow write: if isOwner(userId) || isOwner(friendId);
      }

      match /sharedLists/{listId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId)
          || (settingId == 'publicProfile' && resource.data.shareStats == true);
        allow write: if isOwner(userId);
      }

      match /locations/{locId} {
        allow read: if isOwner(userId) || isFriendOf(userId);
        allow write: if isOwner(userId);
      }
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.fromUserId
        || request.auth.uid == resource.data.toUserId
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUserId;
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.fromUserId
        || request.auth.uid == resource.data.toUserId
      );
    }

    match /sharedTrips/{tripId} {
      allow read: if resource.data.shareScope == 'public'
        || (resource.data.shareScope == 'friends' && isSignedIn())
        || (isSignedIn() && request.auth.uid == resource.data.ownerId);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;

      match /likes/{likeUserId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == likeUserId;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isSignedIn()
          && request.auth.uid == resource.data.userId;
      }

      match /allowedUsers/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/sharedTrips/$(tripId)).data.ownerId;
      }
    }

    match /sharedLists/{listId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId
        || request.auth.uid in resource.data.sharedWith
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId
        || request.auth.uid in resource.data.sharedWith
      );
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;

      match /items/{itemId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/sharedLists/$(listId)).data.ownerId
          || request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.sharedWith
        );
      }
    }

    match /userDirectory/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /squadJoinCodes/{lookupId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId;
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;
    }

    function isSquadMember(data) {
      return request.auth.uid == data.ownerId
        || request.auth.uid in data.get('memberIds', []);
    }

    /** Self-join: append only the caller to memberIds (tripId comes from join-code lookup). */
    function isSquadSelfJoin() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.get('memberIds', [])
        && !(request.auth.uid in resource.data.get('memberIds', []))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt']);
    }

    match /squadTrips/{tripId} {
      allow read: if isSignedIn() && (
        isSquadMember(resource.data)
        || ('joinCode' in resource.data)
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        isSquadMember(resource.data)
        || isSquadSelfJoin()
      );
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;

      match /chat/{messageId} {
        allow read, create: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/squadTrips/$(tripId)).data.ownerId
          || request.auth.uid in get(/databases/$(database)/documents/squadTrips/$(tripId)).data.get('memberIds', [])
        );
        allow update, delete: if isSignedIn()
          && request.auth.uid == resource.data.userId;
      }
    }

    match /public_locations/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /socialActivities/{activityId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.actorId
        || isFriendOf(resource.data.actorId)
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.actorId;
      allow update, delete: if isSignedIn()
        && request.auth.uid == resource.data.actorId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
