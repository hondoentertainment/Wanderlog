# Client (Vite) — copy to .env.local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (optional). Register reCAPTCHA v3 in Firebase Console → App Check, then enforce for Firestore when ready.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=

# Local App Check debug token (optional). Register the printed token in Firebase Console → App Check → Manage debug tokens.
# VITE_APPCHECK_DEBUG_TOKEN=your-debug-token-uuid

# Sentry (optional)
# VITE_SENTRY_DSN=

# Release label for Sentry (optional; Vercel sets VERCEL_GIT_COMMIT_SHA at build — see vite.config define)
# VITE_APP_RELEASE=

# Server-only (Vercel project env, never VITE_*)
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: Upstash Redis for distributed Gemini rate limits (otherwise in-memory per serverless instance)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Comma-separated allowed origins for /api CORS (production custom domain)
# ALLOWED_ORIGIN=https://yourdomain.com

# In Google Cloud Console: restrict the Firebase Browser API key HTTP referrers to your production and preview URLs.
