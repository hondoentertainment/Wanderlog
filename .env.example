VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to true for CI/offline builds without Firebase secrets (see .github/workflows/ci.yml).
VITE_CI_USE_FIREBASE_PLACEHOLDER=
# Used by vite.config.ts `define` and server-side API routes
GEMINI_API_KEY=
# Optional — require Firebase sign-in for /api/gemini (blocks anonymous AI abuse)
GEMINI_REQUIRE_AUTH=
# Client-side Gemini key — dev only; production should use /api/gemini proxy
VITE_GEMINI_API_KEY=
# Optional — PostHog project API key; analytics disabled when unset
VITE_POSTHOG_KEY=
# Set true in dev to route text AI calls through /api/gemini (requires GEMINI_API_KEY in .env.local)
VITE_USE_GEMINI_PROXY=
# Firebase Cloud Messaging — Web Push VAPID key (Firebase Console → Project settings → Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=
# Enable Sign in with Apple button (requires Apple provider in Firebase Auth)
VITE_ENABLE_APPLE_SIGNIN=
# Server-side FCM delivery (JSON service account — Vercel env only, never commit)
FIREBASE_SERVICE_ACCOUNT=
# Optional Upstash Redis for distributed /api/gemini rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional Algolia user search (falls back to Firestore prefix/keyword search)
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=
VITE_ALGOLIA_INDEX_NAME=userDirectory
# Playwright only — injects mock locations (set by playwright.config.ts webServer)
VITE_E2E_FIXTURES=
